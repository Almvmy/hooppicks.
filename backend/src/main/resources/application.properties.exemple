server.port=3001

spring.datasource.url=jdbc:postgresql://localhost:5432/hooppicks
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.username=postgres
spring.datasource.password=TON_MOT_DE_PASSE_ICI

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

app.frontend-url=${FRONTEND_URL}
app.cookie-same-site=${COOKIE_SAME_SITE:None}
app.cookie-secure=${COOKIE_SECURE:true}

balldontlie.api-key=TA_CLE_API_ICI
balldontlie.base-url=https://api.balldontlie.io

nba.sync.use-fixed-window=true
nba.sync.window-start=2026-06-10
nba.sync.window-days=10

admin.api-key=change-moi-en-dev

# Optionnel : uniquement nécessaire pour tester le reset de mot de passe et
# la vérification d'email (envoi via l'API HTTP de Brevo, pas le SMTP :
# beaucoup d'hébergeurs bloquent les ports SMTP sortants)
brevo.api-key=TA_CLE_API_BREVO_ICI
app.mail-from=TON_ADRESSE_EXPEDITEUR

# Optionnel : uniquement nécessaire pour la traduction des actualités
deepl.api-key=TA_CLE_API_ICI
deepl.api-url=https://api-free.deepl.com/v2/translate

# Optionnel : laisse vide en local, Sentry.init() avec un DSN vide désactive
# le SDK proprement (cf. SentryConfig). Utile seulement pour tester
# l'intégration Sentry elle-même en développement.
sentry.dsn=
sentry.environment=local